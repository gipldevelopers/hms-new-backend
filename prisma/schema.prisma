// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource tenant_db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  password         String
  role             Role      @default(SUPERADMIN)
  consoleRoles     Json? // JSON array of roles e.g. ["PHARMACY", "LABORATORY"]
  files            File[]
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status           String    @default("Active")
  isRestricted     Boolean   @default(false)
  shiftType        String? // Day, Night, Emergency
  shiftStartTime   String?
  shiftEndTime     String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  doctorAdmissions Admission[] @relation("DoctorAdmissions")
  assignedTasks    Task[]      @relation("AssignedTasksGlobal")
}

enum Role {
  SUPERADMIN
  BRANCH_ADMIN
  DOCTOR
  STAFF
  RECEPTION
  PHARMACY
  LABORATORY
  RADIOLOGY
  FINANCE
  REPORTS
  HOSPITAL_INVENTORY
}

model Branch {
  id      String  @id @default(uuid())
  name    String  @unique
  code    String  @unique
  email   String  @unique
  contact String
  address String
  city    String
  state   String
  active  Boolean @default(true)

  // Contact Person Information
  contactPersonName  String?
  contactPersonEmail String?
  contactPersonPhone String?

  // Multi-tenant configuration
  dbName     String? @unique // unique database name for this tenant
  dbUser     String?
  dbPassword String?

  tokenPrefix    String  @default("OPD") // Branch admin can change: OPD, GEN, etc.

  isDbInitialized Boolean @default(false)
  schemaVersion   String?

  users          User[]
  assignments    BranchAssignment[]
  shiftTemplates ShiftTemplate[]
  rosters        ShiftRoster[]
  attendance     Attendance[]
  
  departments    Department[]
  wards          Ward[]
  beds           Bed[]
  patients       Patient[]
  admissions     Admission[]
  tokens         Token[]
  vitals         Vitals[]
  tasks          Task[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Patient {
  id        String   @id @default(uuid())
  firstName String?
  lastName  String?
  name      String?   // Full name for backward compatibility
  age       Int?
  gender    String?
  dob       DateTime?
  contact   String?
  alternateMobile String?
  email     String?
  maritalStatus String?
  bloodGroup String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  country   String?
  aadhaar   String?
  pan       String?
  passport  String?
  idProofUrl String?
  emergencyContactName  String?
  emergencyContactPhone String?
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status    String   @default("Complete") // Complete, Incomplete, Emergency, Draft

  // Emergency Registration fields
  arrivalMode     String?  // Walk-In, Ambulance, Referral
  triagePriority  String?  // Red, Yellow, Green
  emergencyType   String?  // e.g. Cardiac Arrest, Severe Trauma
  arrivalTime     DateTime?
  isEmergency     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admissions Admission[]
  tokens     Token[]
  vitals     Vitals[]
  tasks      Task[]

  @@map("patients")
}

model Admission {
  id           String    @id @default(uuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  wardId       String
  ward         Ward      @relation(fields: [wardId], references: [id])
  bedId        String
  bed          Bed       @relation(fields: [bedId], references: [id])
  doctorId     String?
  doctor       User?     @relation("DoctorAdmissions", fields: [doctorId], references: [id])
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  admissionDate DateTime  @default(now())
  dischargeDate DateTime?
  status       String    @default("In Progress") // In Progress, Completed, Pending
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admissions")
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String
  size         Int
  mimetype     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("files")
}

model MasterData {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?            @tenant_db.Text
  fields      Json // Array of field configurations: {id, type, label, required, placeholder}
  records     MasterDataRecord[]
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("master_data")
}

model MasterDataRecord {
  id           String     @id @default(uuid())
  masterDataId String
  masterData   MasterData @relation(fields: [masterDataId], references: [id], onDelete: Cascade)
  data         Json // Key-value pairs: { "fieldName": "value" }
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("master_data_records")
}

model Template {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  category    String             @default("prescription")
  blocks      Json
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("document_templates")
}

model BranchAssignment {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Link to either MasterData or Template (one per row or handle both)
  masterDataId String?
  masterData   MasterData? @relation(fields: [masterDataId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("branch_assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  userRole  String?
  action    String
  module    String
  status    String   @default("SUCCESS")
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ShiftTemplate {
  id            String   @id @default(uuid())
  name          String
  department    String
  type          String // Morning, Evening, Night
  startTime     String
  endTime       String
  breakDuration String
  rule          String // Fixed Shift, etc.
  staffing      Json // { Doctor: 1, Nurse: 2, etc. }
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rosters ShiftRoster[]

  @@map("shift_templates")
}

model ShiftRoster {
  id         String         @id @default(uuid())
  staffId    String // Link to Staff in Tenant DB
  staffName  String // Denormalized for Main DB visibility
  templateId String?
  template   ShiftTemplate? @relation(fields: [templateId], references: [id])
  date       DateTime
  startTime  String
  endTime    String
  department String
  status     String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, ABSENT, LEAVE
  notes      String?
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attendance Attendance?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([branchId])
  @@index([date])
  @@map("shift_rosters")
}

model Attendance {
  id         String       @id @default(uuid())
  staffId    String // Link to Staff in Tenant DB
  staffName  String
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rosterId   String?      @unique // One-to-one with roster entry
  roster     ShiftRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String       @default("PRESENT") // PRESENT, LATE, HALFDAY, OVERTIME, ABSENT
  latitude   Float?
  longitude  Float?
  deviceInfo String?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([branchId])
  @@index([date])
  @@map("attendance_logs")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String
  description String?  @tenant_db.Text
  active      Boolean  @default(true)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wards Ward[]
  admissions Admission[]

  @@unique([branchId, code])
  @@map("departments")
}

model Ward {
  id           String     @id @default(uuid())
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  beds Bed[]
  admissions Admission[]

  @@unique([branchId, code])
  @@map("wards")
}

model Bed {
  id           String   @id @default(uuid())
  label        String
  equipmentId  String?
  wardId       String
  ward         Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status       String   @default("AVAILABLE")
  admissions   Admission[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("beds")
}

model Token {
  id           String   @id @default(uuid())
  tokenNumber  Int      // Daily sequential number: 1, 2, 3...
  prefix       String   @default("OPD") // Snapshot of branch prefix at time of generation
  displayToken String   // e.g. "OPD-001"
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date         DateTime @default(now()) // Used for daily reset grouping
  status       String   @default("Waiting") // Waiting, Called, Completed, Skipped
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([branchId])
  @@index([date])
  @@map("tokens")
}

model Vitals {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  spo2            Int?
  temperature     Float?
  respiratoryRate Int?
  painLevel       Int?
  recordedBy      String?
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("vitals")
}

model Task {
  id           String      @id @default(uuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  bedLabel     String?
  priority     String      @default("MEDIUM")
  dueDate      String?
  assignedToId String?
  assignedTo   User?       @relation("AssignedTasksGlobal", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String      @default("Pending") // Pending, In Progress, Completed

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("tasks")
}
