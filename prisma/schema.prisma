// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource tenant_db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  password     String
  role         Role     @default(SUPERADMIN)
  consoleRoles Json?    // JSON array of roles e.g. ["PHARMACY", "LABORATORY"]
  files        File[]
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status       String   @default("Active")
  isRestricted Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  SUPERADMIN
  BRANCH_ADMIN
  DOCTOR
  STAFF
  RECEPTION
  PHARMACY
  LABORATORY
  RADIOLOGY
  FINANCE
  REPORTS
}

model Branch {
  id      String  @id @default(uuid())
  name    String  @unique
  code    String  @unique
  email   String  @unique
  contact String
  address String
  city    String
  state   String
  active  Boolean @default(true)

  // Contact Person Information
  contactPersonName  String?
  contactPersonEmail String?
  contactPersonPhone String?

  // Multi-tenant configuration
  dbName     String? @unique // unique database name for this tenant
  dbUser     String?
  dbPassword String?

  isDbInitialized Boolean @default(false)
  schemaVersion   String?

  users       User[]
  assignments BranchAssignment[]
  shiftTemplates ShiftTemplate[]
  rosters     ShiftRoster[]
  attendance  Attendance[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String
  size         Int
  mimetype     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("files")
}

model MasterData {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?            @tenant_db.Text
  fields      Json // Array of field configurations: {id, type, label, required, placeholder}
  records     MasterDataRecord[]
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("master_data")
}

model MasterDataRecord {
  id           String     @id @default(uuid())
  masterDataId String
  masterData   MasterData @relation(fields: [masterDataId], references: [id], onDelete: Cascade)
  data         Json // Key-value pairs: { "fieldName": "value" }
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("master_data_records")
}

model Template {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  category    String             @default("prescription")
  blocks      Json
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("document_templates")
}

model BranchAssignment {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Link to either MasterData or Template (one per row or handle both)
  masterDataId String?
  masterData   MasterData? @relation(fields: [masterDataId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("branch_assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  userRole  String?
  action    String
  module    String
  status    String   @default("SUCCESS")
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ShiftTemplate {
  id             String   @id @default(uuid())
  name           String
  department     String
  type           String   // Morning, Evening, Night
  startTime      String
  endTime        String
  breakDuration  String
  rule           String   // Fixed Shift, etc.
  staffing       Json     // { Doctor: 1, Nurse: 2, etc. }
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rosters        ShiftRoster[]

  @@map("shift_templates")
}

model ShiftRoster {
  id             String   @id @default(uuid())
  staffId        String   // Link to Staff in Tenant DB
  staffName      String   // Denormalized for Main DB visibility
  templateId     String?
  template       ShiftTemplate? @relation(fields: [templateId], references: [id])
  date           DateTime
  startTime      String
  endTime        String
  department     String
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, ABSENT, LEAVE
  notes          String?
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attendance     Attendance?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([branchId])
  @@index([date])
  @@map("shift_rosters")
}

model Attendance {
  id           String   @id @default(uuid())
  staffId      String   // Link to Staff in Tenant DB
  staffName    String
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rosterId     String?  @unique // One-to-one with roster entry
  roster       ShiftRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  status       String   @default("PRESENT") // PRESENT, LATE, HALFDAY, OVERTIME, ABSENT
  latitude     Float?
  longitude    Float?
  deviceInfo   String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([branchId])
  @@index([date])
  @@map("attendance_logs")
}