// prisma/tenant.prisma
generator tenant {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

model TenantUser {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  password       String
  role           String   @default("STAFF")
  consoleRoles   Json? // Array of strings
  status         String   @default("Active")
  isRestricted   Boolean  @default(false)
  shiftType      String?
  shiftStartTime String?
  shiftEndTime   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctorAdmissions Admission[] @relation("DoctorAdmissions")
  assignedPatients Patient[]   @relation("StaffPatientAssignments")
  assignedTasks    Task[]      @relation("AssignedTasksTenant")

  @@map("users")
}

model Patient {
  id                    String    @id @default(uuid())
  firstName             String?
  lastName              String?
  name                  String?
  age                   Int?
  gender                String?
  dob                   DateTime?
  contact               String?
  alternateMobile       String?
  email                 String?
  maritalStatus         String?
  bloodGroup            String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String?
  aadhaar               String?
  pan                   String?
  passport              String?
  idProofUrl            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                String    @default("Complete") // Complete, Incomplete, Emergency, Draft

  // Emergency Registration fields
  arrivalMode    String? // Walk-In, Ambulance, Referral
  triagePriority String? // Red, Yellow, Green
  emergencyType  String? // e.g. Cardiac Arrest, Severe Trauma
  arrivalTime    DateTime?
  isEmergency    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  admissions    Admission[]
  tokens        Token[]
  vitals        Vitals[]
  assignedStaff TenantUser[]  @relation("StaffPatientAssignments")
  tasks         Task[]

  @@map("patients")
}

model Admission {
  id            String      @id @default(uuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  wardId        String
  ward          Ward        @relation(fields: [wardId], references: [id])
  bedId         String
  bed           Bed         @relation(fields: [bedId], references: [id])
  doctorId      String?
  doctor        TenantUser? @relation("DoctorAdmissions", fields: [doctorId], references: [id])
  admissionDate DateTime    @default(now())
  dischargeDate DateTime?
  status        String      @default("In Progress") // In Progress, Completed, Pending
  reason        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("admissions")
}

model Appointment {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  doctorId       String? // TenantUser id
  doctorName     String? // Denormalized for display
  departmentId   String?
  departmentName String? // Denormalized for display
  dateTime       DateTime
  tokenNumber    String? // e.g. "A-101"
  fee            Float?
  notes          String?
  status         String   @default("SCHEDULED") // SCHEDULED, CHECKED_IN, WAITING, COMPLETED, CANCELLED, NO_SHOW
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("appointments")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wards      Ward[]
  admissions Admission[]

  @@map("departments")
}

model Ward {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  beds         Bed[]
  admissions   Admission[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("wards")
}

model Bed {
  id          String      @id @default(uuid())
  label       String
  equipmentId String?
  wardId      String
  ward        Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  status      String      @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE, CLEANING
  admissions  Admission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("beds")
}

model TenantShiftTemplate {
  id            String   @id @default(uuid())
  name          String
  department    String
  type          String
  startTime     String
  endTime       String
  breakDuration String
  rule          String
  staffing      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rosters TenantShiftRoster[]

  @@map("shift_templates")
}

model TenantShiftRoster {
  id         String               @id @default(uuid())
  staffId    String
  templateId String?
  template   TenantShiftTemplate? @relation(fields: [templateId], references: [id])
  date       DateTime
  startTime  String
  endTime    String
  department String
  status     String               @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, ABSENT, LEAVE
  notes      String?
  attendance TenantAttendance?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([date])
  @@index([staffId])
  @@map("shift_rosters")
}

model TenantAttendance {
  id         String             @id @default(uuid())
  staffId    String
  rosterId   String?            @unique
  roster     TenantShiftRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String             @default("PRESENT")
  latitude   Float?
  longitude  Float?
  deviceInfo String?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([date])
  @@index([staffId])
  @@map("attendance")
}

model Token {
  id           String   @id @default(uuid())
  tokenNumber  Int // Daily sequential: 1, 2, 3...
  prefix       String   @default("OPD")
  displayToken String // e.g. "OPD-001"
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  status       String   @default("Waiting") // Waiting, Called, Completed, Skipped
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@map("tokens")
}

model Vitals {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  spo2            Int?
  temperature     Float?
  respiratoryRate Int?
  painLevel       Int?
  recordedBy      String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vitals")
}

model Task {
  id           String      @id @default(uuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  bedLabel     String?
  priority     String      @default("MEDIUM")
  dueDate      String?
  assignedToId String?
  assignedTo   TenantUser? @relation("AssignedTasksTenant", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String      @default("Pending") // Pending, In Progress, Completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}
