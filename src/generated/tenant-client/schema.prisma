// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource tenant_db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(SUPERADMIN)
  files     File[]
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPERADMIN
  BRANCH_ADMIN
  DOCTOR
  STAFF
  RECEPTION
  PHARMACY
  LABORATORY
  RADIOLOGY
  FINANCE
  REPORTS
}

model Branch {
  id      String  @id @default(uuid())
  name    String  @unique
  code    String  @unique
  email   String  @unique
  contact String
  address String
  city    String
  state   String
  active  Boolean @default(true)

  // Contact Person Information
  contactPersonName  String?
  contactPersonEmail String?
  contactPersonPhone String?

  // Multi-tenant configuration
  dbName     String? @unique // unique database name for this tenant
  dbUser     String?
  dbPassword String?

  isDbInitialized Boolean @default(false)
  schemaVersion   String?

  users       User[]
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String
  size         Int
  mimetype     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("files")
}

model MasterData {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?            @tenant_db.Text
  fields      Json // Array of field configurations: {id, type, label, required, placeholder}
  records     MasterDataRecord[]
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("master_data")
}

model MasterDataRecord {
  id           String     @id @default(uuid())
  masterDataId String
  masterData   MasterData @relation(fields: [masterDataId], references: [id], onDelete: Cascade)
  data         Json // Key-value pairs: { "fieldName": "value" }
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("master_data_records")
}

model Template {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  category    String             @default("prescription")
  blocks      Json
  assignments BranchAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("document_templates")
}

model BranchAssignment {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Link to either MasterData or Template (one per row or handle both)
  masterDataId String?
  masterData   MasterData? @relation(fields: [masterDataId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("branch_assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  userRole  String?
  action    String
  module    String
  status    String   @default("SUCCESS")
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// prisma/tenant.prisma
generator tenant {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

model TenantUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("STAFF")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Patient {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  bloodGroup  String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments Appointment[]

  @@map("patients")
}

model Appointment {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  dateTime  DateTime
  status    String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specialists Staff[]

  @@map("departments")
}

model Staff {
  id             String      @id @default(uuid())
  firstName      String
  lastName       String
  designation    String
  specialization String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  email          String      @unique
  phone          String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("staff")
}

model Bed {
  id        String   @id @default(uuid())
  bedNumber String   @unique
  wardName  String
  type      String // GENERAL, ICU, PRIVATE
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("beds")
}
