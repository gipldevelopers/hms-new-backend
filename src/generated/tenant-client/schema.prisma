// prisma/tenant.prisma
generator tenant {
  provider = "prisma-client-js"
  output   = "../src/generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

model TenantUser {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  password       String
  role           String   @default("STAFF")
  consoleRoles   Json? // Array of strings
  status         String   @default("Active")
  isRestricted   Boolean  @default(false)
  shiftType      String?
  shiftStartTime String?
  shiftEndTime   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctorAdmissions Admission[] @relation("DoctorAdmissions")
  assignedPatients Patient[]   @relation("StaffPatientAssignments")
  assignedTasks    Task[]      @relation("AssignedTasksTenant")

  @@map("users")
}

model Patient {
  id                    String    @id @default(uuid())
  firstName             String?
  lastName              String?
  name                  String?
  age                   Int?
  gender                String?
  dob                   DateTime?
  contact               String?
  alternateMobile       String?
  email                 String?
  maritalStatus         String?
  bloodGroup            String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String?
  aadhaar               String?
  pan                   String?
  passport              String?
  idProofUrl            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                String    @default("Complete") // Complete, Incomplete, Emergency, Draft

  // Emergency Registration fields
  arrivalMode    String? // Walk-In, Ambulance, Referral
  triagePriority String? // Red, Yellow, Green
  emergencyType  String? // e.g. Cardiac Arrest, Severe Trauma
  arrivalTime    DateTime?
  isEmergency    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments    Appointment[]
  admissions      Admission[]
  tokens          Token[]
  vitals          Vitals[]
  assignedStaff   TenantUser[]     @relation("StaffPatientAssignments")
  tasks           Task[]
  consultations   Consultation[]
  prescriptions   Prescription[]
  bills           Bill[]
  labTestOrders   LabTestOrder[]
  notes           PatientNote[]
  serviceRequests ServiceRequest[]

  @@map("patients")
}

model Admission {
  id            String      @id @default(uuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  wardId        String
  ward          Ward        @relation(fields: [wardId], references: [id])
  bedId         String
  bed           Bed         @relation(fields: [bedId], references: [id])
  doctorId      String?
  doctor        TenantUser? @relation("DoctorAdmissions", fields: [doctorId], references: [id])
  admissionDate DateTime    @default(now())
  dischargeDate DateTime?
  status        String      @default("In Progress") // In Progress, Completed, Pending
  reason        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("admissions")
}

model Appointment {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  doctorId       String? // TenantUser id
  doctorName     String? // Denormalized for display
  departmentId   String?
  departmentName String? // Denormalized for display
  dateTime       DateTime
  tokenNumber    String? // e.g. "A-101"
  fee            Float?
  notes          String?
  status         String   @default("SCHEDULED") // SCHEDULED, CHECKED_IN, WAITING, COMPLETED, CANCELLED, NO_SHOW
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("appointments")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wards      Ward[]
  admissions Admission[]

  @@map("departments")
}

model Ward {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  beds         Bed[]
  admissions   Admission[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("wards")
}

model Bed {
  id          String      @id @default(uuid())
  label       String
  equipmentId String?
  wardId      String
  ward        Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  status      String      @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE, CLEANING
  admissions  Admission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("beds")
}

model TenantShiftTemplate {
  id            String   @id @default(uuid())
  name          String
  department    String
  type          String
  startTime     String
  endTime       String
  breakDuration String
  rule          String
  staffing      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rosters TenantShiftRoster[]

  @@map("shift_templates")
}

model TenantShiftRoster {
  id         String               @id @default(uuid())
  staffId    String
  templateId String?
  template   TenantShiftTemplate? @relation(fields: [templateId], references: [id])
  date       DateTime
  startTime  String
  endTime    String
  department String
  status     String               @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, ABSENT, LEAVE
  notes      String?
  attendance TenantAttendance?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([date])
  @@index([staffId])
  @@map("shift_rosters")
}

model TenantAttendance {
  id         String             @id @default(uuid())
  staffId    String
  rosterId   String?            @unique
  roster     TenantShiftRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String             @default("PRESENT")
  latitude   Float?
  longitude  Float?
  deviceInfo String?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([date])
  @@index([staffId])
  @@map("attendance")
}

model Token {
  id           String   @id @default(uuid())
  tokenNumber  Int // Daily sequential: 1, 2, 3...
  prefix       String   @default("OPD")
  displayToken String // e.g. "OPD-001"
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  status       String   @default("Waiting") // Waiting, Called, Completed, Skipped
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@map("tokens")
}

model Vitals {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  spo2            Int?
  temperature     Float?
  respiratoryRate Int?
  painLevel       Int?
  recordedBy      String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vitals")
}

model Task {
  id           String      @id @default(uuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  bedLabel     String?
  priority     String      @default("MEDIUM")
  dueDate      String?
  assignedToId String?
  assignedTo   TenantUser? @relation("AssignedTasksTenant", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String      @default("Pending") // Pending, In Progress, Completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model PharmacyItem {
  id           String    @id @default(uuid())
  medicineName String
  type         String
  mfg          String?
  quantity     Int       @default(0)
  expiryDate   DateTime?
  notes        String?
  rackId       String?
  storageType  String    @default("Cold Storage")
  status       String    @default("IN STOCK") // IN STOCK, LOW, OUT OF STOCK
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prescriptionItems PrescriptionItem[]

  @@map("pharmacy_items")
}

model Consultation {
  id            String  @id @default(uuid())
  appointmentId String  @unique
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctorName    String?

  // Clinical Notes
  chiefComplaints String?
  clinicalHistory String?
  examination     String?

  // Diagnosis
  provisionalDiagnosis String?
  finalDiagnosis       String?

  // Lab Investigations
  labTests     Json? // Array of lab test names/codes
  labTestOrder LabTestOrder?

  // Prescription
  prescriptions Prescription[]

  // Follow-up
  followUpDate       DateTime?
  followUpNotes      String?
  referralDoctor     String?
  referralDepartment String?

  status    String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consultations")
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctorName     String?

  items PrescriptionItem[]

  instructions String? // General advice/instructions

  // Pharmacy workflow status
  pharmacyStatus String    @default("PENDING") // PENDING, PROCESSING, READY, DISPENSED
  pharmacyNotes  String?
  processedBy    String? // pharmacist name
  processedAt    DateTime?
  dispensedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicineId   String?
  medicine     PharmacyItem? @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName String

  dosage       String // e.g., "1 Tablet", "5ml"
  timing       String // e.g., "1-1-1 (After Food)", "1-0-1"
  duration     String // e.g., "5 Days", "2 Weeks"
  instructions String? // Additional instructions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prescription_items")
}

model Bill {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type            String // "OPD" or "IPD"
  consultationFee Float    @default(0)
  labCharges      Float    @default(0)
  pharmacyCharges Float    @default(0)
  roomCharges     Float    @default(0)
  otherCharges    Float    @default(0)
  discount        Float    @default(0)
  tax             Float    @default(0)
  subtotal        Float    @default(0)
  netPayable      Float    @default(0)
  amountPaid      Float    @default(0)
  paymentMethod   String? // "Cash", "Card", "UPI", etc.
  status          String   @default("UNPAID") // "UNPAID", "PARTIAL", "PAID", "DISCHARGED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bills")
}

model LabTestOrder {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?       @unique
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  doctorId       String?
  doctorName     String?
  departmentName String?
  priority       String        @default("Normal") // Normal, High, Urgent
  status         String        @default("Pending") // Pending, Collecting, Processing, Completed
  tests          Json // Array: { id, name, code, status, timeline }
  clinicalNotes  String?
  orderedAt      DateTime      @default(now())
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([patientId])
  @@index([status])
  @@map("lab_test_orders")
}

model PatientNote {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String // User name who wrote it
  authorRole String // Role (e.g., Nurse, Cardiologist)
  content    String
  fileUrl    String? // Attached document URL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("patient_notes")
}

model ServiceRequest {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientName        String
  bed                String
  requestType        String
  requestDescription String?
  priority           String   @default("Normal") // Normal, Urgent
  dept               String // Laboratory, Radiology, Facilities, Therapy, Blood Bank
  status             String   @default("Pending") // Pending, Accepted, Completed
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("service_requests")
}
